# Atlas Lens Environment Configuration
# Copy to .env for local deployment

# Application Mode (production | development | test)
APP_ENV=development
DEBUG=false
DEMO_MODE=true

# Host & Port Binding
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./atlas_lens.db

# Security & OIDC Settings
SECRET_KEY=change-this-in-production-to-a-random-32-byte-string
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/atlas-lens
OIDC_CLIENT_ID=atlas-lens-client
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=atlas-lens-client

# Keycloak Admin Credentials (for local compose stack)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Optional LLM Gateway Credentials
# Operator configured only - never request input from users
LLM_API_KEY=
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://127.0.0.1:11434
